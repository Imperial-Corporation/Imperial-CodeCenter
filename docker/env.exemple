# Imperial CodeCenter — configuration Docker (copie ce fichier en `.env` à la racine du dépôt).
# Ne publie jamais ton `.env`.

# Obligatoire. Utilise des caractères sans signification dans une URL (lettres et chiffres) :
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Version de l'image à lancer (latest, 1.0.4, …).
# ICC_VERSION=latest

# Adresse et port publiés sur la machine hôte.
# ICC_BIND=127.0.0.1
# ICC_PORT=8000

# Facultatif : jeton d'administration (Authorization: Bearer) en plus du premier compte créé.
# CODECENTER_ADMIN_TOKEN=

# Facultatif : jeton GitHub du crawler (relève la limite de débit). Il peut aussi être saisi dans l'interface.
# GITHUB_TOKEN=

# Derrière un reverse proxy (docs/proxy.md) : nginx ou cloudflare, plus votre domaine.
# CODECENTER_PROXY_MODE=nginx
# CODECENTER_PUBLIC_HOST=code.exemple.fr
# CODECENTER_ALLOWED_HOSTS=code.exemple.fr
# CODECENTER_FORCE_HTTPS=1
# Réseau Docker du proxy (ou son adresse) pour que l'IP réelle soit lue :
# CODECENTER_TRUSTED_PROXIES=172.16.0.0/12

# Autres réglages : voir config/.env.exemple (CODECENTER_USER_RATE, CODECENTER_PROVIDER_NETWORK, …).
